{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opusplan",
  "attribution": {
    "commit": "",
    "sessionUrl": false
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false
  },
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run check:lint)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run test)",
      "Bash(npm run test:unit)",
      "Bash(npm run test:e2e)",
      "Bash(npm run lint)",
      "Bash(npm run format)",
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run preview)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git pull --ff-only)",
      "Bash(git push *)",
      "Bash(gh api repos/{owner}/{repo}/pulls *)",
      "Bash(gh api repos/{owner}/{repo}/pulls/*)",
      "Bash(gh api -X PATCH repos/{owner}/{repo}/pulls/*)",
      "Bash(gh api repos/{owner}/{repo}/commits/*)",
      "Bash(npm ls *)",
      "mcp__claude_ai_Trello__trelloReadBoard",
      "mcp__Trello__trelloReadBoard",
      "mcp__claude_ai_Trello__trelloReadCard",
      "mcp__Trello__trelloReadCard",
      "mcp__claude_ai_Trello__trelloReadChecklist",
      "mcp__Trello__trelloReadChecklist",
      "mcp__claude_ai_Trello__trelloReadList",
      "mcp__Trello__trelloReadList",
      "mcp__claude_ai_Trello__trelloReadMember",
      "mcp__Trello__trelloReadMember",
      "mcp__claude_ai_Trello__trelloSearch",
      "mcp__Trello__trelloSearch"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm ci *)",
      "Bash(npm uninstall *)",
      "Bash(npm remove *)",
      "Bash(npm rm *)",
      "Bash(npm un *)",
      "Bash(npx *)",
      "mcp__claude_ai_Trello__trelloWriteBoard",
      "mcp__Trello__trelloWriteBoard",
      "mcp__claude_ai_Trello__trelloWriteChecklist",
      "mcp__Trello__trelloWriteChecklist",
      "mcp__claude_ai_Trello__trelloWriteInbox",
      "mcp__Trello__trelloWriteInbox",
      "mcp__claude_ai_Trello__trelloWriteList",
      "mcp__Trello__trelloWriteList",
      "mcp__claude_ai_Trello__trelloWritePlanner",
      "mcp__Trello__trelloWritePlanner"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Write(**/.env)",
      "Write(**/.env.*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" != true ] || \"${CLAUDE_PROJECT_DIR}\"/scripts/setup.sh >&2",
            "timeout": 300
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/guard-bash.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__claude_ai_Trello__trelloWriteCard|mcp__Trello__trelloWriteCard",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/guard-trello.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/format-file.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/check-on-stop.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
